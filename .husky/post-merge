set -e

# Only a reminder: this workspace can be pulled while nobody is watching, and
# an automatic install would run dependency install scripts unattended.
if git diff --name-only ORIG_HEAD HEAD 2>/dev/null | grep -qE '^(package\.json|package-lock\.json)$'; then
  echo "📦 package.json or lockfile changed. Run 'npm ci' when you're at the machine."
fi
